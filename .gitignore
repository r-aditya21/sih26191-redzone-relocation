# ============================================================
# SIH26191 — SafeShift / RakshaGrid
# Consolidated .gitignore (backend + frontend + ml + m4)
# ============================================================

# ------------------------------------------------------------
# Environment / secrets — never commit these
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------------------------
# Node / TypeScript (backend + frontend)
# ------------------------------------------------------------
node_modules/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# ------------------------------------------------------------
# Next.js (frontend)
# ------------------------------------------------------------
frontend/.next/
frontend/out/
.next/
out/
next-env.d.ts

# ------------------------------------------------------------
# Python (ml/ and m4/ pipelines)
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
ENV/

# Python tooling / test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter (if anyone explores data in notebooks)
.ipynb_checkpoints/

# ------------------------------------------------------------
# Data
# ------------------------------------------------------------
# Raw source data can be large and often isn't licensed for
# redistribution — keep it local only. See data/README.md.
data/raw/
*.shp
*.shx
*.dbf
*.tif
*.tiff

# Processed/ML pipeline outputs are regenerated by
# `python ml/run_pipeline.py` — don't commit stale copies.
# NOTE: if you want a known-good demo snapshot in git as a
# fallback (offline-first strategy, blueprint section 18),
# comment this line out and commit that one snapshot deliberately.
data/processed/

# data/cleaned/ (chamoli_*.geojson) IS tracked — it's the small,
# curated pilot dataset the whole demo depends on. Do not ignore it.

# ------------------------------------------------------------
# Generated reports (once report-generation ships)
# ------------------------------------------------------------
backend/reports/
backend/tmp/
*.generated.pdf

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log
logs/

# ------------------------------------------------------------
# OS / editor junk
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.code-workspace
*.swp

# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------
*.tmp
*.temp
*.bak